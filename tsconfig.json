{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "src/**/*",
    "__tests__/**/*",
    "demo/**/*",
    "test-support/**/*",
    "data/**/*",
    "scripts/**/*",
    "vitest.config.ts",
    "eslint.config.ts"
  ]
}
